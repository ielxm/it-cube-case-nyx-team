#  Скопируйте этот файл в .env и заполните значения.
#  Если SMTP_HOST или SMTP_USER не заполнены,
#  OTP-код будет выводиться в консоль сервера.
#
#  Пример для Gmail:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=yourmail@gmail.com
#    SMTP_PASS=xxxx xxxx xxxx xxxx   # App Password
#    SMTP_FROM=NYX Admin <yourmail@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
